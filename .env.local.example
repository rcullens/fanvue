# === $0 path (recommended to start) ===
# Leave OPENAI_* empty → local mock reply engine (free, offline).
# FORCE_MOCK_ENGINE=1

# === Optional free/cheap OpenAI-compatible providers ===
# Works with: Ollama, Groq, Google Gemini OpenAI-compat, OpenRouter free models, etc.
# OPENAI_API_KEY=                    # required by most hosted free tiers; Ollama often accepts any/none
# OPENAI_BASE_URL=https://api.openai.com/v1
#   Ollama:  http://localhost:11434/v1
#   Groq:    https://api.groq.com/openai/v1
# OPENAI_MODEL=gpt-4o-mini
#   Ollama example: llama3.2
#   Groq example:   llama-3.1-8b-instant

# === Fanvue OAuth (your OWN Builder app — do not paste secrets into chat) ===
# Create at Fanvue Creator Tools → Build (KYC required). Off-platform app.
FANVUE_CLIENT_ID=
FANVUE_CLIENT_SECRET=
# Aliases also accepted:
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# HTTPS required even for local (mkcert, local-ssl-proxy, or a tunnel).
FANVUE_REDIRECT_URI=https://localhost:3000/api/fanvue/oauth/callback
FANVUE_SCOPES=openid offline_access offline read:self read:creator write:creator read:insights read:chat write:chat read:fan write:media
FANVUE_API_BASE_URL=https://api.fanvue.com
FANVUE_AUTH_BASE_URL=https://auth.fanvue.com
# Used to encrypt token file at data/fanvue-tokens.json
SESSION_SECRET=change-me-to-a-long-random-string

# === Webhooks (prefer over polling) ===
# FANVUE_WEBHOOK_SECRET=             # Standard Webhooks signing secret (verify TODO in stub)

# === Video bots ($0 local preview; GPU lip-sync optional) ===
# VIDEO_PROVIDER=local-ffmpeg
# VIDEO_RENDER_CMD=   # e.g. SadTalker on a GPU box: '... {image} {audio} {out}'
# REPLICATE_API_TOKEN=  # optional later stub — not required
