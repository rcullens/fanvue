# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local JSON store runtime + secrets
data/store.json
data/*.tmp
data/fanvue-tokens.json
data/fanvue-tokens.json.tmp

# TTS venv (edge-tts)
.venv-tts/

# Generated media (keep directory placeholders via .gitkeep)
data/media/portraits/*
!data/media/portraits/.gitkeep
data/media/videos/*
!data/media/videos/.gitkeep
data/media/audio/*
!data/media/audio/.gitkeep
data/media/tmp/*
!data/media/tmp/.gitkeep
